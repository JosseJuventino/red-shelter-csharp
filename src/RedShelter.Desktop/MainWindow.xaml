<Window x:Class="RedShelter.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RedShelter - Animales"
        Height="500"
        Width="750">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal">
            <TextBlock Text="Listado de animales"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,20,0"/>

            <Button Content="Recargar"
                    Command="{Binding CargarAnimalesCommand}"
                    Padding="15,5"/>
            <Button Content="Eliminar animal"
                    Command="{Binding EliminarAnimalCommand}"
                    Margin="10,0,0,0"
                    Padding="15,5"/>
            <Button Content="Editar animal"
                    Command="{Binding EditarAnimalCommand}"
                    Padding="15,5"
                    Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Formulario -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,20,0,15">

            <StackPanel Margin="0,0,15,0">
                <TextBlock Text="Nombre"/>
                <TextBox Width="200"
                         Text="{Binding Nombre,
                         Mode=TwoWay,
                         UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <StackPanel Margin="0,0,15,0">
                <TextBlock Text="Especie"/>
                <TextBox Width="200"
                         Text="{Binding Especie,
                         Mode=TwoWay,
                         UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <Button Content="Guardar animal"
                    Command="{Binding GuardarCommand}"
                    Padding="15,5"
                    VerticalAlignment="Bottom"/>
        </StackPanel>

        <!-- Listado -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Animales}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectedItem="{Binding AnimalSeleccionado, Mode=TwoWay}"
                  SelectionMode="Single">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre"
                                    Binding="{Binding Name}"
                                    Width="*"/>

                <DataGridTextColumn Header="Especie"
                                    Binding="{Binding Species}"
                                    Width="*"/>

                <DataGridCheckBoxColumn Header="Disponible"
                                        Binding="{Binding IsAvailable}"
                                        Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Estado -->
        <StatusBar Grid.Row="3">
            <TextBlock Text="{Binding MensajeEstado}"/>
        </StatusBar>
    </Grid>
</Window>
